generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model PortfolioItem {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  image     String
  location  String
  createdAt DateTime @default(now())
}

model Service {
  id            Int      @id @default(autoincrement())
  title         String
  startingPrice String
  description   String
  icon          String
  createdAt     DateTime @default(now())
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String
  weddingDate String
  location    String
  message     String
  createdAt   DateTime @default(now())
}

model Booking {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  date        String
  venue       String
  package     String
  details     String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}
